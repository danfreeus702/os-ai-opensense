<model>
  <mount>//OPNsense/aiopensense</mount>
  <description>
    OPNsense AI assistant configuration
  </description>
  <items>
    <general>
      <enabled type="BooleanField">
        <default>1</default>
        <Required>Y</Required>
      </enabled>

      <!-- Cloud LLM provider. Ollama/local is intentionally not offered. -->
      <provider type="OptionField">
        <default>openrouter</default>
        <OptionValues>
          <openrouter>OpenRouter (recommended)</openrouter>
          <nvidia>NVIDIA NIM</nvidia>
        </OptionValues>
        <Required>Y</Required>
      </provider>
      <api_endpoint type="TextField">
        <Required>N</Required>
      </api_endpoint>
      <model type="TextField">
        <Required>N</Required>
      </model>
      <api_key_file type="TextField">
        <default>/conf/aiopensense.key</default>
        <Required>Y</Required>
      </api_key_file>
      <send_context type="BooleanField">
        <default>1</default>
        <Required>N</Required>
      </send_context>

      <!-- Legacy fields retained so existing configs migrate cleanly. -->
      <ollama_host type="TextField">
        <Required>N</Required>
      </ollama_host>
      <ollama_model type="TextField">
        <Required>N</Required>
      </ollama_model>

      <system_prompt type="TextField">
        <default>You are AIOpenSense, an AI assistant for OPNsense firewall administration. You help with firewall rules, ad blocking, Unbound DNS over TLS configuration, and general network security advice. Answer concisely and practically. When giving step-by-step instructions, reference the OPNsense GUI menus.</default>
        <Required>N</Required>
      </system_prompt>
      <temperature type="TextField">
        <default>0.4</default>
        <Required>N</Required>
      </temperature>
      <max_tokens type="TextField">
        <default>2048</default>
        <Required>N</Required>
      </max_tokens>
      <timeout type="TextField">
        <default>45</default>
        <Required>N</Required>
      </timeout>
    </general>
  </items>
</model>
